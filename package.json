{
  "name": "dsh-usage-kimi-cn",
  "version": "1.0.2",
  "description": "DSH command plugin: /usage-kimi-cn command and composer readout for your Kimi (Moonshot AI) Coding Plan subscription quota usage",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "jooey",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "kimi",
    "moonshot",
    "coding-plan",
    "usage",
    "quota",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jooey/dsh-usage-kimi-cn.git"
  },
  "bugs": {
    "url": "https://github.com/jooey/dsh-usage-kimi-cn/issues"
  },
  "homepage": "https://github.com/jooey/dsh-usage-kimi-cn#readme"
}
